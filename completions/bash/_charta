#!/bin/bash

# Bash completion for charta: the command, then note names after open
_charta() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    COMPREPLY=()
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "init new open list help" -- "$cur"))
    elif [[ $COMP_CWORD -eq 2 ]]; then
        case "${COMP_WORDS[1]}" in
            open)
                local IFS=$'\n'
                COMPREPLY=($(compgen -W "$(charta list 2>/dev/null)" -- "$cur"))
                ;;
            help)
                COMPREPLY=($(compgen -W "init new open list" -- "$cur"))
                ;;
        esac
    fi
}

complete -F _charta charta
